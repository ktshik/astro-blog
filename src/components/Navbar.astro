---
import classnames from "classnames";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;

const navItems = {
  "/": {
    name: "Home",
  },
  "/blog": {
    name: "Writing",
  },
};
---

<header class="pb-6 mb-3">
  <div class="flex flex-row flex-wrap items-center justify-between gap-4">
    <nav
      class="nav-primary flex flex-row items-center gap-5 sm:gap-6 text-base font-[JetBrains_Mono] font-medium tracking-tight text-[var(--fg-muted)]"
      aria-label="Primary"
    >
      {
        Object.entries(navItems).map(([path, { name }]) => (
          <a
            class={classnames(
              "transition-colors duration-200 ease-out",
              "hover:text-[var(--fg)]",
              path === pathname && "text-[var(--fg)]"
            )}
            href={path}
            data-active={path === pathname ? "true" : "false"}
          >
            {name}
          </a>
        ))
      }
    </nav>
    <ThemeToggle />
  </div>
</header>
