---
import ArrowIcon from "./ArrowIcon.astro";

const { href, label } = Astro.props;
---

<a
  class="inline-flex items-center gap-2 text-[var(--fg)] transition-colors duration-200 ease-out hover:text-[var(--fg-muted)] underline underline-offset-[0.2em] decoration-[color-mix(in_srgb,var(--fg)_30%,transparent)] hover:decoration-[var(--fg-muted)]"
  rel="noopener noreferrer"
  target="_blank"
  href={href}
>
  <ArrowIcon />
  <span class="leading-none py-1">{label}</span>
</a>
