---
interface ShieldData {
  label: string;
}

interface ShieldCategory {
  title: string;
  shields: ShieldData[];
}

const categories: ShieldCategory[] = [
  {
    title: "Languages",
    shields: [
      { label: "node.js" },
      { label: "typescript" },
    ],
  },
  {
    title: "Data",
    shields: [
      { label: "postgres" },
      { label: "mongodb" },
      { label: "redis" },
      { label: "bigquery" },
    ],
  },
  {
    title: "Infrastructure",
    shields: [
      { label: "docker" },
      { label: "k8s" },
      { label: "rabbitmq" },
      { label: "aws" },
      { label: "gcp" },
      { label: "terraform" },
      { label: "cloudflare" },
    ],
  },
  {
    title: "AI",
    shields: [
      { label: "cursor" },
      { label: "claude" },
      { label: "openai" },
    ],
  },
];
---

<div class="flex flex-col gap-3">
  {
    categories.map((category) => (
      <div>
        <p class="text-[0.8125rem] font-medium uppercase tracking-[0.18em] text-[var(--fg-muted)] mb-1.5">
          {category.title}
        </p>
        <div class="flex flex-wrap gap-x-4 gap-y-1 font-[JetBrains_Mono] text-[0.9375rem] text-[var(--fg)]">
          {category.shields.map((shield) => (
            <span>{shield.label}</span>
          ))}
        </div>
      </div>
    ))
  }
</div>
