---
import HomeSection from "../components/HomeSection.astro";
import Links from "../components/Links.astro";
import Shields from "../components/Shields.astro";
import Timeline from "../components/Timeline.astro";
import Root from "../layouts/Root.astro";
---

<Root>
  <section class="flex w-full min-w-0 flex-col gap-12">
    <div class="flex flex-col-reverse items-start gap-8 sm:flex-row">
      <div class="min-w-0 flex-1">
        <h1 class="!mb-2 font-[JetBrains_Mono] text-4xl sm:text-5xl font-semibold tracking-tight text-[var(--fg)]">
          ktshik
        </h1>
        <p class="font-[JetBrains_Mono] text-base text-[var(--fg-muted)] mb-4">
          ai · backend · platform
        </p>
        <p class="text-xl leading-snug tracking-tight text-[var(--fg-muted)] max-w-prose">
         Hi, I'm Julian! I build backend systems for the agentic frontier.</p>
      </div>
      <img
        class="w-full aspect-[3/2] object-cover sm:w-1/2 sm:flex-1 select-none"
        src="/profile.jpg"
        alt="Profile picture"
        width="600"
        height="400"
        draggable="false"
      />
    </div>
    <HomeSection title="Contact">
      <Links />
    </HomeSection>
    <HomeSection title="Stack">
      <Shields />
    </HomeSection>
    <HomeSection title="Experience">
      <Timeline />
    </HomeSection>
  </section>
</Root>
